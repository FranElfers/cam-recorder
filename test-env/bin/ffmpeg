#!/bin/bash
# Mock ffmpeg script for testing on Arch Linux without AMD VA-API

# Find the real ffmpeg
REAL_FFMPEG="/usr/bin/ffmpeg"

args=()
skip_next=0

for arg in "$@"; do
    if [[ $skip_next -gt 0 ]]; then
        skip_next=$((skip_next - 1))
        continue
    fi

    case "$arg" in
        -hwaccel|-hwaccel_device|-hwaccel_output_format)
            skip_next=1
            ;;
        hevc_vaapi)
            args+=("libx265")
            ;;
        h264_vaapi)
            args+=("libx264")
            ;;
        *)
            args+=("$arg")
            ;;
    esac
done

echo "[Mock FFmpeg] Running: $REAL_FFMPEG ${args[@]}"
exec "$REAL_FFMPEG" "${args[@]}"
